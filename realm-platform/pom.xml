<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-platform</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：运维管理（Internal Developer Platform 的一部分）
        Responsibility boundary: operations management (part of Internal Developer Platform)
        仅包含：定时任务管理、服务器信息等运维管理能力
        Only contains: job scheduling management, server information, and other ops management
        capabilities
        不包含：研发工具（代码生成器、数据源管理等，归 realm-devtools）；
                底层基础设施（连接池、消息队列在 framework 层）；
                定时任务的执行引擎（调度引擎在 realm-scheduling）
        Does not contain: developer tools (code generators, datasource management — these
        belong to realm-devtools); low-level infrastructure (connection pools, message
        queues are in the framework layer); the job execution engine (the scheduling engine
        is in realm-scheduling)
        本模块是模块化单体中的单 Maven 模块（库），由 realm-server 聚合启动；
        不独立部署，不包含 spring-boot-maven-plugin 的 repackage。
        This module is a single Maven module (library) in the modular monolith, aggregated
        and started by realm-server; it is not deployed independently and does not include
        spring-boot-maven-plugin's repackage.
    -->
    <description>
        运维管理：定时任务管理、服务器信息等。
        不含代码生成器、数据源管理等研发工具（realm-devtools）；
        不含底层基础设施（连接池、消息队列在 framework 层）；
        不含定时任务执行引擎（调度引擎在 realm-scheduling）。
        Operations management: job scheduling management, server information, etc.
        No developer tools (code generators, datasource management — realm-devtools);
        no low-level infrastructure (connection pools, message queues are in the framework layer);
        no job execution engine (the scheduling engine is in realm-scheduling).
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            技术契约：realm-core / Technical contracts: realm-core
            提供 BusinessException、通用枚举；任务注册失败、服务器信息查询异常时
            抛出 BusinessException（携带错误码），由 realm-web 的
            GlobalExceptionHandler 统一转换，本模块不处理 HTTP 响应
            Provides BusinessException, common enums; job registration failures and server
            info query errors throw BusinessException (with an error code), which realm-web's
            GlobalExceptionHandler converts; this module does not handle HTTP responses
            compile：契约在编译期与运行期都需要
            compile: contracts are needed at compile and runtime
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!--
            通用工具类：realm-utils / General utilities: realm-utils
            提供字符串、集合、日期等工具；任务标识归一化、Cron 表达式处理需要
            Provides string, collection, date utilities; needed for job identifier
            normalization and cron expression handling
            compile：工具方法在编译期与运行期都需要
            compile: utilities are needed at compile and runtime
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-utils</artifactId>
        </dependency>

        <!--
            自动配置基础：@AutoConfiguration / @ConditionalOnClass / @ConfigurationProperties
            Auto-configuration foundation
            本模块包含自动配置类与配置属性类，必须显式声明；
            与 realm-data-access、realm-data-jpa、realm-data-redis 等模块风格一致
            This module contains auto-configuration and configuration-property classes;
            declared explicitly for consistency with realm-data-access, realm-data-jpa,
            realm-data-redis, etc.
            compile：自动配置类直接使用
            compile: auto-configuration classes use it directly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Spring Boot 基础：@Service / @Component / @Configuration / @Transactional
            Spring Boot foundation: @Service / @Component / @Configuration / @Transactional
            业务模块的 Bean 注册、依赖注入与本地事务基础；由父 POM 的依赖管理统一版本
            Foundation for bean registration, dependency injection, and local transactions
            in business modules; version managed by the parent POM
            compile：业务类直接使用
            compile: business classes use it directly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            持久化：realm-mybatis-plus-spring-boot-starter（或 realm-data-jpa-spring-boot-starter）
            Persistence: realm-mybatis-plus-spring-boot-starter (or realm-data-jpa-spring-boot-starter)
            infra_job、infra_job_log 表的持久化
            Persistence of infra_job and infra_job_log tables
            compile：本模块的核心运行时依赖（二选一）
            compile: core runtime dependency of this module (pick one)
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-mybatis-plus-spring-boot-starter</artifactId>
        </dependency>

        <!--
            Web 层：realm-web-spring-boot-starter
            Web layer: realm-web-spring-boot-starter
            管理后台的 REST API（定时任务 CRUD、启停、执行日志查询、
            服务器信息查询）
            Admin backend REST APIs (job CRUD, start/stop, execution log queries,
            server information queries)
            compile：Controller 直接使用
            compile: controllers use it directly
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-web-spring-boot-starter</artifactId>
        </dependency>

        <!--
            调度抽象：realm-scheduling-spring-boot-starter
            Scheduling abstraction: realm-scheduling-spring-boot-starter
            通过调度引擎 SPI 与执行器交互（注册/暂停/恢复任务），不直接绑定
            具体的调度引擎（Quartz/XXL-JOB 由 realm-scheduling 管理）
            Interacts with executors via the scheduling engine SPI (register/pause/resume),
            without binding to a specific scheduling engine (Quartz/XXL-JOB are managed by
            realm-scheduling)
            compile：任务管理直接使用调度 SPI
            compile: job management uses the scheduling SPI directly
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-scheduling-spring-boot-starter</artifactId>
        </dependency>

        <!--
            操作审计：realm-audit-logging-spring-boot-starter
            Operational audit logging: realm-audit-logging-spring-boot-starter
            定时任务的创建、修改、启停、删除等敏感操作需要审计；通过 @AuditLog 注解
            Sensitive operations like job creation, modification, start/stop, and deletion
            need auditing; through the @AuditLog annotation
            compile：@AuditLog 注解直接使用
            compile: the @AuditLog annotation is used directly
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-audit-logging-spring-boot-starter</artifactId>
        </dependency>

        <!--
            服务器信息采集（可选）：spring-boot-starter-actuator
            Server info collection (optional): spring-boot-starter-actuator
            从 /actuator/info、/actuator/health、/actuator/metrics 读取服务器信息
            Reads server information from /actuator/info, /actuator/health, /actuator/metrics
            optional：如果服务器信息采集不通过 Actuator（例如通过 JMX 或自建采集器），
            可以移除
            optional: if server info is not collected via Actuator (e.g., via JMX or a
            custom collector), it can be removed
            compile：Actuator 的 API 直接使用
            compile: Actuator's API is used directly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            注意：本模块不引入 realm-devtools。
            运维管理（定时任务、服务器信息）与研发工具（代码生成器、数据源管理）
            是两个不同的关注点，消费者不同（运维 vs 开发者），变更节奏不同。
            Note: this module does NOT introduce realm-devtools.
            Operations management (job scheduling, server info) and developer tools
            (code generators, datasource management) are different concerns with different
            consumers (ops vs developers) and different change cadences.
        -->

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
            Test support (test): realm's test base classes and mock environment
            test 作用域，不传递到生产
            test scope, not propagated to production
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
