<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-feature-env-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：特性环境的流量染色与标签路由
        Responsibility boundary: feature-environment traffic tagging and label-based routing
        仅包含：入站流量染色（Servlet Filter）、FeatureEnvContext 上下文、
                出站调用标签传播（RequestInterceptor SPI）、
                基于标签的负载均衡实例筛选（Spring Cloud LoadBalancer 集成）
        Only contains: inbound traffic tagging (Servlet Filter), FeatureEnvContext,
                outbound label propagation (RequestInterceptor SPI),
                label-based load-balancer instance filtering (Spring Cloud LoadBalancer integration)
        不包含：服务发现与负载均衡算法本身、MQ 隔离、数据库/缓存隔离、网关染色规则
        Does not contain: service discovery & load-balancing algorithms, MQ isolation,
                DB/cache isolation, gateway tagging rules
        路由决策依赖 Spring Cloud LoadBalancer 的 HintBasedServiceInstanceListSupplier 机制，
        不重新发明实例筛选逻辑；该机制默认不启用，需配置
        spring.cloud.loadbalancer.configurations=hint 或在代码中显式注册
        Routing decisions rely on Spring Cloud LoadBalancer's HintBasedServiceInstanceListSupplier
        mechanism; instance filtering logic is not reinvented. The mechanism is disabled by default;
        enable it via spring.cloud.loadbalancer.configurations=hint or explicit registration in code
        依据：Spring Cloud Tencent featureenv 的“实例打标 → 流量染色 → 标签路由”三阶段模型；
        W3C Baggage（可选标签传播载体）
        Basis: Spring Cloud Tencent featureenv's three-phase model
        (instance tagging → traffic tagging → label routing); W3C Baggage (optional tag carrier)
    -->
    <description>
        特性环境的流量染色与标签路由：入站染色、FeatureEnvContext 上下文、出站传播、
        基于 Spring Cloud LoadBalancer hint 机制的实例筛选。
        不包含服务发现/负载均衡算法、MQ 隔离、数据隔离、网关染色规则。
        Feature-environment traffic tagging and label-based routing: inbound tagging, FeatureEnvContext,
        outbound propagation, instance filtering via Spring Cloud LoadBalancer hint mechanism.
        No service discovery/load-balancing algorithms, MQ isolation, data isolation, or gateway tagging rules.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            技术契约：realm-core / Technical contracts: realm-core
            提供 BusinessException、通用枚举；染色标识非法、路由失败时
            抛出 BusinessException（携带错误码），由 realm-web 的
            GlobalExceptionHandler 统一转换，本模块不处理 HTTP 响应
            Provides BusinessException, common enums; invalid tag identifiers and routing
            failures throw BusinessException (with an error code), which realm-web's
            GlobalExceptionHandler converts; this module does not handle HTTP responses
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!--
            通用工具类：realm-utils / General utilities: realm-utils
            提供字符串、集合等工具；标签值归一化、请求头匹配需要
            Provides string, collection utilities; needed for tag value normalization
            and header matching
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-utils</artifactId>
        </dependency>

        <!--
            核心：Spring Cloud LoadBalancer / Core: Spring Cloud LoadBalancer
            提供 ServiceInstanceListSupplier、HintBasedServiceInstanceListSupplier、
            ReactorLoadBalancer；特性环境的“标签匹配 → 实例筛选”直接建立在其 hint 机制上，
            不重新实现实例过滤
            Provides ServiceInstanceListSupplier, HintBasedServiceInstanceListSupplier,
            ReactorLoadBalancer; feature-env "label matching → instance filtering" builds
            directly on its hint mechanism; instance filtering is not reimplemented
            compile：本模块的路由能力依赖它，不可 optional
            compile: this module's routing capability depends on it; cannot be optional
            注意：HintBasedServiceInstanceListSupplier 默认不启用，需配置
            spring.cloud.loadbalancer.configurations=hint，或在代码中通过
            LoadBalancerClientConfiguration 显式注册；否则 hint 机制不生效
            Note: HintBasedServiceInstanceListSupplier is disabled by default; enable it via
            spring.cloud.loadbalancer.configurations=hint, or register it explicitly via
            LoadBalancerClientConfiguration in code; otherwise the hint mechanism is inactive
            版本由 Spring Cloud BOM 管理
            Version managed by Spring Cloud BOM
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!--
            自动配置基础：@AutoConfiguration / @ConditionalOnClass / @ConfigurationProperties
            Auto-configuration foundation
            提供条件装配、配置属性绑定；本模块的 Filter、RequestInterceptor、
            LB 定制 Bean 依赖它
            Provides conditional assembly and configuration property binding; this module's
            Filter, RequestInterceptor, and LB customization beans rely on it
            compile：自动配置类直接使用；与 realm-data-access、realm-data-jpa、
            realm-data-redis、realm-distributed-transaction 等模块风格一致
            compile: auto-configuration classes use it directly; consistent with
            realm-data-access, realm-data-jpa, realm-data-redis, and
            realm-distributed-transaction
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Servlet API（provided）：入站流量染色的 Web 过滤器
            Servlet API (provided): web filter for inbound traffic tagging
            从 HttpServletRequest 读取特性环境标签并写入 FeatureEnvContext；
            FeatureEnvContextFilter 通过 @ConditionalOnClass(jakarta.servlet.Filter.class)
            条件化，非 Web 应用（无 Servlet API）引入本模块时不会因此启动失败
            Reads the feature-env label from HttpServletRequest and writes it into
            FeatureEnvContext; FeatureEnvContextFilter is gated by
            @ConditionalOnClass(jakarta.servlet.Filter.class); non-web apps
            (without Servlet API) will not fail to start
            provided：由 Web 容器提供；本模块不强制引入 Web 栈
            provided: supplied by the web container; this module does not force a web stack
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Spring Web（provided）：RequestContextHolder 的编译期依赖
            Spring Web (provided): compile-time dependency for RequestContextHolder
            如果 FeatureEnvContext 或出站 RequestInterceptor 通过 RequestContextHolder
            获取当前请求，需要 spring-web；如果只用 HttpServletRequest
            （来自 jakarta.servlet-api），则本依赖可省略
            If FeatureEnvContext or the outbound RequestInterceptor uses RequestContextHolder
            to obtain the current request, spring-web is required; if only HttpServletRequest
            (from jakarta.servlet-api) is used, this dependency can be omitted
            注意：spring-cloud-commons 中的 spring-web 是 optional，不会传递引入，
            因此直接 import spring-web 类型时必须显式声明
            Note: spring-web in spring-cloud-commons is optional and is not propagated;
            declare it explicitly when importing spring-web types directly
            provided：由应用或 Web 栈提供；本模块不传递
            provided: supplied by the app or web stack; not propagated
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            OpenFeign 集成（optional）：出站调用的标签自动传播
            OpenFeign integration (optional): automatic label propagation for outbound calls
            通过 RequestInterceptor 将 FeatureEnvContext 中的标签注入 Feign 请求头；
            不使用 OpenFeign 的应用不应被迫引入
            Injects the label from FeatureEnvContext into Feign request headers via
            RequestInterceptor; apps not using OpenFeign should not be forced to pull it in
            optional：相关 RequestInterceptor 通过 @ConditionalOnClass 条件化
            optional: the related RequestInterceptor is gated by @ConditionalOnClass
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-openfeign-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            OpenTelemetry API（optional）：W3C Baggage 作为标签传播的可选载体
            OpenTelemetry API (optional): W3C Baggage as an optional tag carrier
            如果应用希望使用标准 Baggage 头传播特性环境标签，通过 OTel Propagator 注入；
            否则使用自定义请求头
            If the app prefers W3C Baggage headers for feature-env labels, use OTel
            Propagators; otherwise a custom header is used
            optional：不强制 Baggage 传播方式；相关配置通过 @ConditionalOnClass 条件化
            optional: Baggage propagation is not forced; related configs gated by @ConditionalOnClass
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            自动配置元数据生成器（optional）：生成 spring-autoconfigure-metadata.properties
            Autoconfigure metadata processor (optional)
            启动时提前过滤不匹配的自动配置，降低启动开销
            Pre-filters non-matching auto-configurations at startup to reduce boot cost
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito；
            用于验证入站染色、上下文传播、LB hint 筛选
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito; used to verify
            inbound tagging, context propagation, and LB hint filtering
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
            Test support (test): realm's test base classes and mock environment
            test 作用域，不传递到生产 / test scope, not propagated to production
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
