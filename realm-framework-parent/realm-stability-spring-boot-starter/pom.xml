<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-stability-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：可观测性 + 稳定性保护
        Responsibility boundary: observability + stability protection
        仅包含：指标采集与暴露、链路追踪、日志辅助、限流、熔断、幂等、分布式锁
        Only contains: metrics collection & exposure, tracing, logging helpers,
                rate limiting, circuit breaking, idempotency, distributed locks
        不包含：发布管理、容量规划、成本治理、混沌工程等其它 ops 能力
        Does not contain: release management, capacity planning, cost governance,
                chaos engineering, or other ops capabilities
        所有能力条件装配、可退让；不使用 Redis 的应用可关闭限流/幂等/分布式锁，
        仅保留可观测性——但 realm-data-redis 是 optional，需应用显式引入
        All capabilities conditionally assembled and deferable; apps not using Redis can
        disable rate limiting/idempotency/distributed locks and keep observability only —
        but realm-data-redis is optional and must be explicitly pulled in by the app
    -->
    <description>
        可观测性与稳定性保护：指标采集与暴露、链路追踪、限流、熔断、幂等、分布式锁。
        不包含发布、容量、成本、混沌工程等其它 ops 能力。
        Observability / stability protection: metrics collection/exposure, tracing,
        rate limiting, circuit breaking, idempotency, distributed locks.
        No release management, capacity planning, cost governance, or chaos engineering.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            技术契约：realm-core / Technical contracts: realm-core
            提供 BusinessException、通用枚举；限流/熔断的异常响应与指标标签复用时
            抛出 BusinessException（携带Tier Points），由 realm-web 的
            GlobalExceptionHandler 统一转换，本模块不处理 HTTP 响应
            Provides BusinessException, common enums; rate-limit/circuit-break error
            responses and metric tags throw BusinessException (with an error code),
            which realm-web's GlobalExceptionHandler converts; this module does not
            handle HTTP responses
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!--
            自动配置基础：@AutoConfiguration / @ConditionalOnClass / @ConfigurationProperties
            Auto-configuration foundation
            提供条件装配与配置属性绑定；本模块的自动配置类与配置属性类直接依赖
            Provides conditional assembly and configuration property binding; this module's
            auto-configuration and configuration-property classes depend on it directly
            compile：自动配置类直接使用；与 realm-data-access、realm-data-jpa、
            realm-data-redis、realm-distributed-transaction、realm-feature-env、
            realm-file、realm-messaging、realm-multitenancy、realm-mybatis-plus、
            realm-object-storage、realm-openfeign、realm-scheduling 等模块风格一致
            compile: auto-configuration classes use it directly; consistent with
            realm-data-access, realm-data-jpa, realm-data-redis,
            realm-distributed-transaction, realm-feature-env, realm-file, realm-messaging,
            realm-multitenancy, realm-mybatis-plus, realm-object-storage, realm-openfeign,
            and realm-scheduling
            Note: spring-boot-starter-aop transitively brings it, but declared explicitly
            per "use directly, declare directly"
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Web 基础：realm-web-spring-boot-starter（provided）
            Web foundation: realm-web-spring-boot-starter (provided)
            提供 realm 的 Web 契约与配置；provided 不强制传递，使用方可自行选择 Web 栈
            Provides realm's web contracts & configuration; provided does not force
            propagation, letting consumers choose their web stack
            限流/幂等拦截器通过 @ConditionalOnClass(jakarta.servlet.Filter.class) 条件化，
            非 Web 应用引入本模块时相关配置退让
            Rate-limit/idempotency interceptors are gated by
            @ConditionalOnClass(jakarta.servlet.Filter.class); non-web apps importing
            this module have the related configs backed off
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-web-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Spring MVC API（provided）：TraceFilter 与限流/幂等拦截器编译需要
            Spring MVC API (provided): needed at compile time by TraceFilter and
            rate-limit/idempotency interceptors
            provided 不传递，因此显式声明；运行时由 Web 栈提供
            provided is not transitive, hence declared explicitly; supplied by the web
            stack at runtime
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Servlet API（provided）：TraceFilter 与拦截器编译需要
            Servlet API (provided): needed at compile time by TraceFilter and interceptors
            provided 不传递，因此显式声明；运行时由容器提供
            provided is not transitive, hence declared explicitly; supplied by the
            container at runtime
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            AOP 切面支持：监控拦截、限流/熔断切面
            AOP support: monitoring interception and rate-limit/circuit-break aspects
            compile：本模块的核心运行时能力
            compile: core runtime capability of this module
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            OpenTelemetry API：本模块的 TraceContextFilter 在运行时直接使用
            OpenTelemetry API: used at runtime by this module's TraceContextFilter
            compile：API 需在编译期可见；运行时由 sdk 提供实现
            compile: API visible at compile time; implementation provided by sdk at runtime
            注意：compile 作用域意味着 API 会传递给所有下游应用，
            @ConditionalOnClass(OpenTelemetry.class) 总是通过；
            SDK 缺席时 GlobalOpenTelemetry.get() 返回 no-op，traceId 为空，
            而不是“退化为自管理 traceId”；FallbackTraceIdGenerator 仅在
            opentelemetry-api 完全缺席时生效，compile 作用域下它不会缺席
            Note: compile scope means the API propagates to all downstream apps;
            @ConditionalOnClass(OpenTelemetry.class) always passes; when the SDK is
            absent, GlobalOpenTelemetry.get() returns a no-op and traceId is empty,
            rather than "falling back to a self-managed traceId"; FallbackTraceIdGenerator
            only takes effect when opentelemetry-api is entirely absent, which never
            happens under compile scope
            版本由 realm-dependencies 中导入的 opentelemetry-bom 统一管理
            Version managed by the opentelemetry-bom imported in realm-dependencies
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!--
            OpenTelemetry SDK：自动配置构建 SdkTracerProvider 时必须存在
            OpenTelemetry SDK: must be present when auto-configuration builds SdkTracerProvider
            compile 而非 optional：optional 会让依赖不传递给使用方，
            导致启动时 NoClassDefFoundError
            compile, not optional: optional would not propagate to consumers, causing
            NoClassDefFoundError at startup
            版本由 realm-dependencies 中导入的 opentelemetry-bom 统一管理
            Version managed by the opentelemetry-bom imported in realm-dependencies
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>

        <!--
            OpenTelemetry OTLP 导出器：启用 OTLP 导出时构建 OtlpGrpcSpanExporter
            OpenTelemetry OTLP exporter: builds OtlpGrpcSpanExporter when OTLP export is enabled
            compile 而非 optional：exporter 类必须在使用方运行时类路径上
            compile, not optional: exporter classes must be on the consumer's runtime
            classpath
            注意：opentelemetry-exporter-otlp 会传递引入 gRPC、protobuf 等较重依赖；
            若团队统一使用 OTel Java Agent 或 SkyWalking，应删除本依赖，
            避免 gRPC/protobuf 传递给所有应用，而不是改回 optional
            Note: opentelemetry-exporter-otlp transitively brings gRPC, protobuf, and
            other heavy dependencies; if the team uniformly uses the OTel Java Agent or
            SkyWalking, remove this dependency instead of reverting to optional, to
            avoid propagating gRPC/protobuf to all apps
            版本由 realm-dependencies 中导入的 opentelemetry-bom 统一管理
            Version managed by the opentelemetry-bom imported in realm-dependencies
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!--
            OpenTelemetry SDK 自动配置扩展（optional）：使用方需要环境变量/系统属性
            配置 SDK 时自行引入
            OpenTelemetry SDK autoconfigure extension (optional): consumers pull it in
            when they want env-var/system-property based SDK configuration
            本模块自动配置直接使用 Builder API，不依赖本扩展
            This module's auto-configuration uses Builder API directly and does not depend
            on this extension
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Micrometer 核心：指标埋点的门面
            Micrometer core: metrics instrumentation facade
            本模块的指标采集代码直接使用 MeterRegistry、Timer、Counter；
            按“直接使用即直接声明”原则显式引入
            This module's metric collection code uses MeterRegistry, Timer, Counter
            directly; declared explicitly per "use directly, declare directly"
            optional：MeterRegistry 缺席时降级为 no-op；与 micrometer-registry-prometheus
            解耦，应用可选用其他 registry
            optional: degrades to no-op when MeterRegistry is absent; decoupled from
            micrometer-registry-prometheus, apps may use other registries
            注意：optional 依赖要求指标埋点相关的配置类通过
            @ConditionalOnClass(MeterRegistry.class) 条件化
            Note: optional dependency requires metric-instrumentation configs to be gated
            by @ConditionalOnClass(MeterRegistry.class)
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Micrometer Prometheus Registry（optional）：使用方需要 /actuator/prometheus
            端点时引入
            Micrometer Prometheus registry (optional): consumers pull it in when they
            need /actuator/prometheus
            不强制传递，避免不需要 Prometheus 的应用带上完整 registry
            Not forced, avoiding a full registry for apps that don't need Prometheus
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Actuator（optional）：指标暴露端点
            Actuator (optional): metrics exposure endpoints
            提供 /actuator/health、/actuator/metrics、/actuator/prometheus 等管理端点
            Provides /actuator/health, /actuator/metrics, /actuator/prometheus management
            endpoints
            optional：应用需要端点时显式引入，本模块不强制所有应用暴露管理端点
            optional: apps pull it in when endpoints are needed; this module does not
            force management endpoint exposure
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Spring Boot Admin 客户端（optional）：使用方需要接入 Admin 控制台时引入
            Spring Boot Admin client (optional): consumers pull it in when they need
            Admin console integration
            不强制传递，避免不需要 Admin 的应用带上客户端
            Not forced, avoiding the client for apps that don't need Admin
        -->
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Redis 集成：分布式锁存储、限流计数器、幂等键持久化
            Redis integration: distributed lock storage, rate-limit counters,
            idempotency key persistence
            optional：不使用保护能力的应用不应被迫引入 Redis；相关自动配置类
            通过 @ConditionalOnClass(RedisTemplate.class) 条件化
            optional: apps not using protection capabilities should not be forced to
            pull in Redis; related auto-configs gated by
            @ConditionalOnClass(RedisTemplate.class)
            注意：optional 依赖要求保护相关的配置类不能被无条件加载的配置类直接引用，
            否则应用没有 Redis 时会抛 NoClassDefFoundError
            Note: optional dependency requires protection configs not to be directly
            referenced by unconditionally loaded configs; otherwise apps without Redis
            throw NoClassDefFoundError
            使用保护能力的应用必须显式引入本依赖
            Apps using protection capabilities must pull in this dependency explicitly
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-data-redis-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            分布式锁实现：lock4j + Redisson（optional）
            Distributed lock implementation: lock4j + Redisson (optional)
            使用方可按需替换为自有锁机制
            Consumers may replace with their own lock mechanism
            版本由 realm-dependencies 的 lock4j.version 管理
            Version managed by realm-dependencies' lock4j.version
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            自动配置元数据生成器（optional）：生成 spring-autoconfigure-metadata.properties
            Autoconfigure metadata processor (optional): generates
            spring-autoconfigure-metadata.properties
            启动时提前过滤不匹配的自动配置，降低启动开销
            Pre-filters non-matching auto-configurations at startup to reduce boot cost
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito；
            用于验证条件装配、指标埋点、限流/熔断切面
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito; used to verify
            conditional assembly, metrics instrumentation, and rate-limit/circuit-break
            aspects
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
            Test support (test): realm's test base classes and mock environment
            test 作用域，不传递到生产 / test scope, not propagated to production
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
