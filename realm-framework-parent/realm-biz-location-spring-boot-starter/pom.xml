<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-biz-location-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：位置信息服务（IP 定位 + 城市数据查询）
        Responsibility boundary: location information service (IP geolocation + city data lookup)
        仅包含：IP → 城市信息（ip2region）、城市编码 → 城市信息（内置城市字典）、
                真实客户端 IP 提取（Servlet 可选）
        Only contains: IP → city info (ip2region), city code → city info (built-in city dictionary),
                real client IP extraction (optional Servlet)
        不包含：风控决策、登录审计、权限判断等业务逻辑；本模块只提供只读查询能力，不消费查询结果
        Does not contain: risk decisions, login auditing, authorization; this module provides
        read-only lookup only, does not consume results
        定位：业务支撑组件（biz），不承载业务语义，可被任意业务模块依赖
        Positioning: business-support component (biz), no business semantics, dependency for
        any business module
    -->
    <description>
        位置信息服务：IP 地址解析为城市信息，城市编码查询城市信息。
        内置城市字典，离线运行，不依赖外部服务；真实客户端 IP 提取为可选能力。
        不包含风控、审计、权限等业务逻辑。
        Location information service: resolves IP addresses to city info, looks up city info by code.
        Built-in city dictionary, offline operation, no external service dependency;
        real client IP extraction is an optional capability.
        No risk control, auditing, or authorization logic.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            技术契约：realm-core / Technical contracts: realm-core
            提供 BusinessException、通用枚举；IP 库加载失败、城市编码不存在时
            抛出 BusinessException（携带错误码），由 realm-web 的
            GlobalExceptionHandler 统一转换，本模块不处理 HTTP 响应
            Provides BusinessException, common enums; IP-library load failure or unknown
            city code throws BusinessException (with an error code), which realm-web's
            GlobalExceptionHandler converts; this module does not handle HTTP responses
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!--
            通用工具类：realm-utils / General utilities: realm-utils
            提供字符串、集合、校验等工具；IP 格式校验、城市名归一化需要
            Provides string, collection, validation utilities; needed for IP format validation
            and city-name normalization
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-utils</artifactId>
        </dependency>

        <!--
            自动配置基础：@AutoConfiguration / @ConditionalOnClass / @ConfigurationProperties
            Auto-configuration foundation
            本模块包含自动配置类与配置属性类，必须显式声明；
            与 realm-audit-logging、realm-data-scope、realm-authorization、
            realm-biz-location、realm-config-client、realm-data-access、
            realm-data-jpa、realm-data-redis、realm-distributed-transaction、
            realm-feature-env、realm-file、realm-messaging、realm-multitenancy、
            realm-mybatis-plus、realm-object-storage、realm-openfeign、
            realm-scheduling、realm-stability、realm-web 等模块风格一致
            This module contains auto-configuration and configuration-property classes;
            declared explicitly for consistency with realm-audit-logging, realm-data-scope,
            realm-authorization, realm-biz-location, realm-config-client, realm-data-access,
            realm-data-jpa, realm-data-redis, realm-distributed-transaction,
            realm-feature-env, realm-file, realm-messaging, realm-multitenancy,
            realm-mybatis-plus, realm-object-storage, realm-openfeign, realm-scheduling,
            realm-stability, and realm-web
            compile：自动配置类直接使用
            compile: auto-configuration classes use it directly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            IP 定位：ip2region / IP geolocation: ip2region
            提供离线 xdb 查询，支持 IPv4/IPv6；是本模块 IP → 城市信息的核心数据源
            Provides offline xdb lookup with IPv4/IPv6 support; core data source for
            IP → city info
            compile：核心运行时依赖 / compile: core runtime dependency
            版本由父 POM 的 dependencyManagement 管理（ip2region.version）
            Version managed by parent POM's dependencyManagement
        -->
        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
        </dependency>

        <!--
            JSON 解析：Jackson / JSON parsing: Jackson
            用于加载内置城市字典（resources 下的 JSON 文件）；本模块直接使用 ObjectMapper
            Used to load the built-in city dictionary (JSON files under resources);
            this module uses ObjectMapper directly
            compile：直接使用即直接声明，不依赖 realm-core 的传递路径
            compile: declared explicitly since used directly, not relying on realm-core's
            transitive path
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
            Servlet API（provided）：真实客户端 IP 提取的可选实现
            Servlet API (provided): optional implementation for real client IP extraction
            仅用于解析 X-Forwarded-For / X-Real-IP / Proxy-Client-IP 等代理头；
            相关类通过 @ConditionalOnClass(jakarta.servlet.Filter.class) 条件化
            Used only to parse proxy headers like X-Forwarded-For / X-Real-IP /
            Proxy-Client-IP; related classes gated by @ConditionalOnClass(jakarta.servlet.Filter.class)
            provided：由 Web 容器提供；本模块不强制引入 Web 栈
            provided: supplied by the web container; this module does not force a web stack
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            本地缓存：Caffeine（optional） / Local cache: Caffeine (optional)
            用于缓存 IP → 城市信息的查询结果，减少 xdb 重复查询；应用按需引入
            Used to cache IP → city info results, reducing repeated xdb lookups;
            apps pull it in on demand
            optional：缓存相关配置类通过 @ConditionalOnClass(Caffeine.class) 条件化，
            Caffeine 缺席时退化为无缓存
            optional: cache-related configs gated by @ConditionalOnClass(Caffeine.class);
            degrades to no-cache when Caffeine is absent
            版本由 realm-dependencies 的 caffeine.version 管理
            Version managed by realm-dependencies' caffeine.version
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            自动配置元数据生成器（optional）：生成 spring-autoconfigure-metadata.properties
            Autoconfigure metadata processor (optional): generates
            spring-autoconfigure-metadata.properties
            启动时提前过滤不匹配的自动配置，降低启动开销
            Pre-filters non-matching auto-configurations at startup to reduce boot cost
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito；
            用于验证 xdb 加载与城市字典解析
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito;
            used to verify xdb loading and city dictionary parsing
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
            Test support (test): realm's test base classes and mock environment
            test 作用域，不传递到生产
            test scope, not propagated to production
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!--
            .xdb 是二进制文件，必须关闭 filtering 避免被 Maven 资源过滤损坏；
            其他资源保留默认 filtering 配置
            .xdb is binary; filtering must be off to avoid corruption by Maven resource
            filtering; other resources keep the default filtering behavior
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*.xdb</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.xdb</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

</project>
