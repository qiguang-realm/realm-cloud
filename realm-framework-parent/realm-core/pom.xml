<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-core</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>

    <!--
        职责边界：纯技术契约 / Responsibility boundary: pure technical contracts
        仅包含：PageResult、ApiResponse、BusinessException、通用枚举
        Only contains: PageResult, ApiResponse, BusinessException, common enums
        不含业务语义，不含工具类，不含 Web 运行时逻辑
        No business semantics, no utilities, no web runtime logic
        工具类请使用 realm-utils；Web 横切能力请使用 realm-web-spring-boot-starter
        Use realm-utils for utilities; use realm-web-spring-boot-starter for web cross-cutting concerns
    -->
    <description>
        纯技术契约：统一响应体、分页结构、业务异常基类、通用枚举。
        不含业务语义、工具类或 Web 运行时逻辑。
        Pure technical contracts: unified response, pagination, base business exception,
        common enums. No business semantics, utilities, or web runtime logic.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            契约序列化：Jackson / Contract serialization: Jackson
            契约类的 JSON 序列化/反序列化需要，是契约层的核心运行时依赖
            Required for JSON serialization/deserialization of contract classes;
            core runtime dependency of the contract layer
            必须 compile，不能 provided：没有“容器”会为下游应用提供 Jackson
            Must be compile, not provided: no container will provide Jackson for downstream apps
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <!-- Java 8 时间类型支持 / Java 8 date-time support -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            OpenAPI 注解：@Schema 用于契约类的文档描述
            OpenAPI annotations: @Schema for contract class documentation
            optional：仅在启用 OpenAPI 时生效，不传递到下游
            optional: only effective when OpenAPI is enabled; not propagated downstream
            只引入 swagger-annotations-jakarta（纯注解），不引入
            springdoc-openapi-starter-webmvc-ui（后者会传递引入 spring-webmvc、swagger-ui 等
            完整 Web 栈，与 realm-core “不含 Web 运行时逻辑”的定位冲突）
            Uses only swagger-annotations-jakarta (pure annotations), not
            springdoc-openapi-starter-webmvc-ui (the latter transitively brings
            spring-webmvc, swagger-ui, and the full web stack, conflicting with
            realm-core's "no web runtime logic" positioning)
            版本由父 POM 的 swagger-annotations.version 统一管理
            Version managed by parent POM's swagger-annotations.version
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            参数校验 API：契约类上的 @NotNull 等注解
            Bean validation API: @NotNull etc. on contract classes
            provided：由 Jakarta Bean Validation 实现（如 Hibernate Validator）提供；
            下游应用通过 spring-boot-starter-validation 或 web starter 获得它，
            realm-core 不传递，避免与下游自己的校验版本冲突
            provided: supplied by Jakarta Bean Validation implementation (e.g. Hibernate Validator);
            downstream apps obtain it via spring-boot-starter-validation or the web starter;
            realm-core does not propagate it, avoiding version conflicts with downstream's own validation
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
             方法级安全：spring-security-core / Method-level security: spring-security-core
             Controller 上的 @PreAuthorize("@ss.hasPermission(...)") 编译期需要；
             只引入 spring-security-core（API），不引入 spring-boot-starter-security，
             避免把认证过滤器链带进业务模块
             The @PreAuthorize("@ss.hasPermission(...)") on controllers needs it at
             compile time; only spring-security-core (API) is pulled in, NOT
             spring-boot-starter-security, avoiding the authentication filter chain in a
             business module
             compile：注解直接使用，运行时元数据也需可见
             compile: annotations used directly; metadata must be visible at runtime
             注意：realm-web 中的 spring-security-core 是 provided，不传递到本模块，
             因此必须在此显式声明
             Note: realm-web's spring-security-core is provided and does not propagate
             to this module, so it must be declared explicitly here
             运行时前提：
             1) 容器中必须存在名为 "ss" 的 Bean（@PreAuthorize 的 SpEL 引用），
                通常由 realm-server 或安全配置注册；
             2) 某个 @Configuration 类必须标注 @EnableMethodSecurity，
                否则 @PreAuthorize 会被静默忽略，权限校验不生效
             Runtime prerequisites:
             1) A bean named "ss" must exist in the container (SpEL reference of
                @PreAuthorize), usually registered by realm-server or security config;
             2) Some @Configuration class must be annotated with @EnableMethodSecurity,
                otherwise @PreAuthorize is silently ignored and permission checks do
                not take effect
         -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
            前提：realm-core 中存在 @ConfigurationProperties 类；如果没有，可以移除
            Prerequisite: realm-core contains @ConfigurationProperties classes;
            if none, this dependency can be removed
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito、Hamcrest
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito, Hamcrest
            对纯契约类的单元测试，实际只需要 JUnit 5 + AssertJ；
            如果希望进一步收窄，可改为 junit-jupiter + assertj-core，但不强制
            For unit tests on pure contract classes, only JUnit 5 + AssertJ are needed;
            to narrow further, switch to junit-jupiter + assertj-core, but not required
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
