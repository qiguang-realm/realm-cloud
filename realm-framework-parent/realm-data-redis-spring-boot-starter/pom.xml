<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-data-redis-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：Redis 数据访问抽象层（Spring Data Redis 的 realm 定制版）
        Responsibility boundary: Redis data access abstraction (realm customization of Spring Data Redis)
        仅包含：RedisTemplate 序列化默认值、RedisCacheManager 缓存配置、
                Redisson 作为唯一 RedisConnectionFactory、JavaTimeModule 注册
        Only contains: RedisTemplate serialization defaults, RedisCacheManager cache configuration,
                Redisson as the sole RedisConnectionFactory, JavaTimeModule registration
        不包含：分布式锁 / 限流器 / 分布式集合等 Redisson 工具 API、业务缓存语义、Redis 服务端治理
        Does not contain: Redisson distributed lock / rate limiter / distributed collections APIs,
                business cache semantics, or Redis server-side governance
        分布式工具能力归属 realm-stability-spring-boot-starter；
        本模块只做数据访问与缓存抽象
        Distributed tooling belongs to realm-stability-spring-boot-starter;
        this module only does data access & cache abstraction
    -->
    <description>
        Redis 数据访问抽象层：RedisTemplate 序列化默认值、RedisCacheManager 缓存配置、
        Redisson 作为唯一连接工厂、JavaTimeModule 注册。
        不包含 Redisson 分布式工具 API、业务缓存语义或 Redis 服务端治理。
        Redis data access abstraction: RedisTemplate serialization defaults, RedisCacheManager configuration,
        Redisson as the sole connection factory, JavaTimeModule registration.
        No Redisson distributed tooling APIs, business cache semantics, or Redis server-side governance.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            技术契约：realm-core / Technical contracts: realm-core
            提供 BusinessException、通用枚举；缓存序列化失败、Redis 连接异常时
            抛出 BusinessException（携带错误码），由 realm-web 的
            GlobalExceptionHandler 统一转换为 ProblemDetail 或 ApiResponse，
            本模块不处理 HTTP 响应
            Provides BusinessException, common enums; cache serialization failures and
            Redis connection errors throw BusinessException (with an error code), which
            realm-web's GlobalExceptionHandler converts to ProblemDetail or ApiResponse;
            this module does not handle HTTP responses
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!--
            通用工具类：realm-utils / General utilities: realm-utils
            提供字符串、集合等工具；缓存 key 归一化、TTL 计算等需要
            Provides string, collection utilities; needed for cache key normalization
            and TTL calculation
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-utils</artifactId>
        </dependency>

        <!--
            自动配置基础：@AutoConfiguration / @ConditionalOnClass / @ConfigurationProperties
            Auto-configuration foundation
            本模块包含自动配置类与配置属性类，必须显式声明；
            与 realm-audit-logging、realm-data-scope、realm-authorization、
            realm-biz-location、realm-config-client、realm-data-access、
            realm-data-jpa 风格一致
            This module contains auto-configuration and configuration-property classes;
            declared explicitly for consistency with realm-audit-logging, realm-data-scope,
            realm-authorization, realm-biz-location, realm-config-client, realm-data-access,
            and realm-data-jpa
            compile：自动配置类直接使用 / compile: auto-configuration classes use it directly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Spring Cache 抽象：注解式缓存（@Cacheable / @CacheEvict / @CachePut）
            Spring Cache abstraction: annotation-driven caching
            compile：本模块提供 RedisCacheManager 的 realm 默认配置，@Cacheable 依赖它生效
            compile: this module provides realm defaults for RedisCacheManager;
            @Cacheable depends on it
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!--
            Redisson Spring Boot Starter：Redisson 作为唯一 Redis 客户端与连接工厂
            Redisson Spring Boot Starter: Redisson as the sole Redis client & connection factory
            传递引入 Spring Data Redis API（RedisTemplate / RedisConnectionFactory 接口），
            但连接由 RedissonConnectionFactory 提供
            Transitively brings Spring Data Redis APIs; connections are provided by
            RedissonConnectionFactory
            compile：本模块的核心运行时依赖
            compile: core runtime dependency
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <exclusions>
                <!--
                    排除 Lettuce：Redisson 的 RedissonConnectionFactory 与 Lettuce 的
                    LettuceConnectionFactory 都实现 RedisConnectionFactory，
                    同时存在会导致 Bean 冲突或行为不确定
                    Exclude Lettuce: both RedissonConnectionFactory and LettuceConnectionFactory
                    implement RedisConnectionFactory; coexistence causes bean conflicts or
                    nondeterministic behavior
                -->
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
                <!--
                    排除 starter 捆绑的 redisson-spring-data-41：
                    redisson-spring-data-35 与 redisson-spring-data-41 是不同的 artifactId，
                    Maven 不会去重，两者同时存在会导致同名的 RedissonConnectionFactory
                    类被不同版本提供，行为不可预测
                    Exclude the starter's bundled redisson-spring-data-41:
                    redisson-spring-data-35 and redisson-spring-data-41 are different artifactIds,
                    Maven does not deduplicate them; coexistence makes the same RedissonConnectionFactory
                    class provided by different versions, leading to unpredictable behavior
                    注意：升级 Redisson 版本时，必须检查 starter 捆绑的 redisson-spring-data-XX
                    版本并同步更新此 exclusion；建议配合 maven-enforcer-plugin 的
                    bannedDependencies 作为兜底
                    Note: when upgrading Redisson, check the starter's bundled
                    redisson-spring-data-XX version and update this exclusion accordingly;
                    pair with maven-enforcer-plugin's bannedDependencies as a safety net
                -->
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-data-41</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Redisson Spring Data 35：适配 Spring Data Redis 3.5.x（对应 Spring Boot 3.5.x）
            Redisson Spring Data 35: matches Spring Data Redis 3.5.x (Spring Boot 3.5.x)
            显式锁定版本，避免 starter 升级后默认引入 redisson-spring-data-40 或更高版本导致不兼容
            Explicitly pinned to avoid the starter defaulting to redisson-spring-data-40+ after upgrades
            依据：Redisson 官方兼容性矩阵——Spring Boot 3.5.x → redisson-spring-data-35
            Basis: Redisson official compatibility matrix — Boot 3.5.x → redisson-spring-data-35
            版本由父 POM 的 redisson.version 统一管理
            Version managed by parent POM's redisson.version
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-data-35</artifactId>
        </dependency>

        <!--
            Jackson JSR-310：Java 8 时间类型（LocalDateTime / Instant 等）的序列化模块
            Jackson JSR-310: serialization module for Java 8 date-time types
            compile：RedisTemplate 的 ObjectMapper 必须注册 JavaTimeModule，
            否则时间类型写入阶段直接失败
            compile: the RedisTemplate ObjectMapper must register JavaTimeModule;
            otherwise date-time types fail at write time
            注意：仅引入依赖不够，starter 内部必须显式注册 JavaTimeModule
            并禁用 WRITE_DATES_AS_TIMESTAMPS
            Note: dependency alone is insufficient; the starter must explicitly register
            JavaTimeModule and disable WRITE_DATES_AS_TIMESTAMPS
            ObjectMapper 本身由 redisson-spring-boot-starter 传递引入
            （Redisson 用它做序列化）；如果本模块代码直接 import ObjectMapper，
            应显式声明 jackson-databind
            ObjectMapper itself is transitively brought by redisson-spring-boot-starter
            (Redisson uses it for serialization); if this module's code directly imports
            ObjectMapper, jackson-databind should be declared explicitly
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            自动配置元数据生成器（optional）：生成 spring-autoconfigure-metadata.properties
            Autoconfigure metadata processor (optional): generates
            spring-autoconfigure-metadata.properties
            启动时提前过滤不匹配的自动配置，降低启动开销
            Pre-filters non-matching auto-configurations at startup to reduce boot cost
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional)
            编译期生成 IDE 配置提示，运行时不需
            Generates IDE configuration hints at compile time; not needed at runtime
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            编译期工具：Lombok / Compile-time tooling: Lombok
            optional：纯编译期注解处理器，运行时不需要，不传递
            optional: pure compile-time annotation processor; not needed at runtime,
            not propagated
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
            spring-boot-starter-test 提供 JUnit 5、AssertJ、Mockito；
            用于验证序列化配置与缓存条件装配
            spring-boot-starter-test brings JUnit 5, AssertJ, Mockito;
            used to verify serialization config and conditional cache assembly
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
            Test support (test): realm's test base classes and mock environment
            test 作用域，不传递到生产 / test scope, not propagated to production
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                依赖治理兜底：禁止 redisson-spring-data-40 及以上版本出现在依赖树中，
                防止 redisson-spring-boot-starter 升级后 exclusion 失效
                Dependency governance safety net: ban redisson-spring-data-40 and above
                from the dependency tree, preventing the exclusion from becoming stale
                after redisson-spring-boot-starter is upgraded
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-incompatible-redisson-spring-data</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.redisson:redisson-spring-data-40</exclude>
                                        <exclude>org.redisson:redisson-spring-data-41</exclude>
                                        <exclude>org.redisson:redisson-spring-data-42</exclude>
                                        <exclude>org.redisson:redisson-spring-data-43</exclude>
                                    </excludes>
                                    <message>
                                        仅允许 redisson-spring-data-35（匹配 Spring Boot 3.5.x）；
                                        升级 Spring Boot 或 Redisson 时同步调整
                                        Only redisson-spring-data-35 is allowed (matching Spring Boot 3.5.x);
                                        adjust when upgrading Spring Boot or Redisson
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
