        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-report-server</artifactId>
            <version>${revision}</version>
        </dependency>
        -->

        <!-- 工作流（默认注释，保证编译速度） / Workflow (commented by default) -->
