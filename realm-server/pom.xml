<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>

    <!--
        职责边界：模块化单体的唯一可运行入口 / Responsibility boundary: the sole runnable entry of the modular monolith
        组装所有业务模块与基础 starter，提供 main() 启动类，触发 Spring Modulith 的
        ApplicationModules.of(Application.class).verify() 边界验证。
        Assembles all business modules and foundation starters, provides the main() entry,
        and triggers Spring Modulith's ApplicationModules.of(Application.class).verify()
        boundary validation.

        部署定位：当前阶段的生产部署单元（模块化单体）；与 realm-gateway 配合，
        构成完整的生产部署拓扑。当某个业务模块满足提取阈值、被拆分为独立 -server
        应用后，本模块继续承载剩余未提取的模块，不会消失。
        Deployment: the production deployment unit in the current stage (modular monolith);
        together with realm-gateway, it forms the complete production topology. When a
        business module meets the extraction threshold and is split into an independent
        -server application, this module continues to host the remaining modules and
        does not disappear.

        本模块不包含业务逻辑；业务逻辑全部在业务模块中。它的唯一职责是“组装 + 启动 +
        边界验证”。
        This module contains no business logic; all business logic lives in business modules.
        Its sole responsibility is "assemble + start + boundary verification".
    -->
    <description>
        模块化单体的唯一可运行入口：组装所有业务模块与基础 starter，触发 Spring Modulith 边界验证。
        不包含业务逻辑；当前阶段即生产部署单元，部分模块提取后承载剩余模块。
        The sole runnable entry of the modular monolith: assembles all business modules and
        foundation starters, triggers Spring Modulith boundary validation.
        No business logic; the production deployment unit in the current stage, and the host
        of remaining modules after partial extraction.
    </description>

    <!-- 项目地址 / Project URL -->
    <url>https://github.com/qiguang-realm/java-realm</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!--
            基础 starter：HTTP 入站横切 / Foundation starter: HTTP inbound cross-cutting
            RFC 9457 ProblemDetail、W3C Trace Context、日志脱敏、分页绑定、CORS
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-web-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：数据访问基础设施 / Foundation starter: data access infrastructure
            连接池、多数据源路由、事务管理器基础
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-data-access-spring-boot-starter</artifactId>
        </dependency>

        <!--
            ORM 适配：MyBatis-Plus / ORM adapter: MyBatis-Plus
            如果团队选择 JPA 而非 MyBatis-Plus，替换为 realm-data-jpa-spring-boot-starter
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-mybatis-plus-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：Redis 数据访问抽象 / Foundation starter: Redis data access abstraction
            RedisTemplate 序列化、RedisCacheManager、Redisson 连接工厂
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-data-redis-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：授权决策 / Foundation starter: authorization decisions
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-authorization-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：操作审计 / Foundation starter: operational audit logging
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-audit-logging-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：租户上下文生命周期 / Foundation starter: tenant context lifecycle
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-multitenancy-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：传输中立的消息抽象 / Foundation starter: transport-neutral messaging abstraction
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-messaging-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：调度基础设施抽象 / Foundation starter: scheduling infrastructure abstraction
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-scheduling-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：文件数据交换抽象 / Foundation starter: file data exchange abstraction
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-file-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：对象存储统一抽象 / Foundation starter: unified object storage abstraction
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-object-storage-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：可观测性 + 稳定性保护 / Foundation starter: observability + stability protection
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-stability-spring-boot-starter</artifactId>
        </dependency>

        <!--
            基础 starter：配置中心客户端接入 / Foundation starter: config-center client integration
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-config-client-spring-boot-starter</artifactId>
        </dependency>

        <!--
            业务模块：核心领域 / Business modules: core domain
            承载主要业务逻辑 / Carry the primary business logic
        -->
        <!-- 注意：这里依赖的是 -server 实现模块，而不是父模块 -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-workforce-identity-server</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-customer</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-payment</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-intelligence</artifactId>
        </dependency>

        <!--
            业务模块：支撑子域 / Business modules: supporting subdomain
            为业务模块提供通用能力 / Provide shared capabilities to business modules
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-devtools</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-analytics</artifactId>
        </dependency>

        <!--
            注册中心：Nacos Discovery / Service registry: Nacos Discovery
            网关通过 lb://service-name 路由到本模块注册的实例
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
            配置中心：Nacos Config / Config center: Nacos Config
            与 realm-config-client-spring-boot-starter 的 SPI 对接
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!--
            配置元数据生成器（optional）：生成 IDE 配置提示
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试相关 / Testing
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 用于 ModularityTest 执行 verify() -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            测试支撑（test）：realm 项目的测试基类与 Mock 环境
        -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- 构建配置 / Build configuration -->
    <build>

        <!-- 设置构建的 JAR 包名 / Set the final JAR name -->
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <!--
                Spring Boot 打包插件：将本模块打包为包含全部依赖的可执行 JAR
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>
