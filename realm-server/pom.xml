            <artifactId>realm-module-pay-server</artifactId>
            <version>${revision}</version>
        </dependency>
        -->

        <!-- 微信公众号模块（默认注释，保证编译速度） / WeChat MP module (commented by default) -->
        <!--
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-mp-server</artifactId>
            <version>${revision}</version>
        </dependency>
        -->

        <!-- 商城相关模块（默认注释，保证编译速度） / Mall modules (commented by default) -->
        <!--
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-product-server</artifactId>
            <version>${revision}</version>
        </dependency>
        -->
