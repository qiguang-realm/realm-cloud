<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ============================================================
         Logback 日志配置（logback-spring.xml）
         参考 Spring Boot defaults.xml / file-appender.xml
         ============================================================ -->

    <!-- ==== 日志格式 ==== -->
    <!-- 占位符：%d 日期 / %thread 线程 / %-5level 级别 / %logger{50} 记录器 / %L 行号 / %msg 消息 / %n 换行 -->
    <property name="CONSOLE_LOG_PATTERN" value="..."/>
    <property name="FILE_LOG_PATTERN" value="..."/>

    <!-- ==== Appender ==== -->
    <!-- STDOUT / FILE / ASYNC / SkyWalking（注释） -->

    <!-- ==== Root ==== -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
