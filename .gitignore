# =================================================================
# 1. 操作系统通用文件 (Operating System Generated Files)
# =================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =================================================================
# 2. 集成开发环境 (IDE) 与 编辑器 (Editor)
# =================================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.settings/
.project
.classpath
.metadata

# VS Code
.vscode/
*.code-workspace
.history/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# =================================================================
# 3. Java 与 Spring Boot
# =================================================================

# 编译后的字节码文件
*.class

# 构建输出目录 (Maven, Gradle)
target/
build/

# 打包后的文件
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# JVM 崩溃日志与堆转储
hs_err_pid*.log
replay_pid*.log
*.hprof

# Maven Wrapper：保留 mvnw / mvnw.cmd / .mvn/wrapper/*，供团队使用
# （不忽略任何 wrapper 相关文件）

# Gradle Wrapper：保留 gradlew / gradlew.bat / gradle/wrapper/*，供团队使用
.gradle/

# flatten-maven-plugin 生成的临时文件
.flattened-pom.xml
**/.flattened-pom.xml

# Spring Boot 本地私有配置（其他环境配置应提交）
application-local.yml
application-local.yaml
application-local.properties

# =================================================================
# 4. Node.js 与 前端 (React, Vue, Angular, UMI 等)
# =================================================================

# 依赖目录
node_modules/

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建输出目录
dist/
dist-ssr/
.umi/
.umi-production/
.umi-test/
.out/
.vite/
.nuxt/
.next/

# 缓存目录
.cache/
.parcel-cache/
.coverage
.nyc_output/

