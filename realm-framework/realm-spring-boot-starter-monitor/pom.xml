<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-monitor</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>服务监控模块，提供链路追踪、日志服务、指标收集等功能 / Service monitoring module: tracing, logging, and metrics collection
    </description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 通用基础库 / Common library -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!-- AOP 切面支持（用于监控拦截） / AOP support (for monitoring interception) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Web 支持（provided：仅 TraceFilter 使用） / Web support (provided: used only by TraceFilter) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Servlet API（provided：仅 TraceFilter 使用） / Servlet API (provided: used only by TraceFilter) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            OpenTelemetry API：compile 作用域。
            realm-core 中的 TraceContextFilter 在运行时直接使用
            io.opentelemetry.api.trace.Span / io.opentelemetry.api.OpenTelemetry，
            API 由 realm-core 以 compile 传递；此处显式声明是为了让本模块
            对 OTel API 的依赖不依赖传递路径，避免未来 realm-core 调整时
            本模块编译失败。版本由父 POM 的 opentelemetry-bom 统一管理。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!--
            OpenTelemetry SDK：compile 作用域，不是 optional。
            本模块的自动配置类负责构建 SdkTracerProvider（见 MonitorAutoConfiguration），
            运行时必须有 SDK 类才能初始化。optional 会让本依赖不传递给
            realm-module-system-server 等使用方，导致启动时
            NoClassDefFoundError: io/opentelemetry/sdk/trace/SdkTracerProvider。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>

        <!--
            OpenTelemetry OTLP 导出器：compile 作用域，不是 optional。
            自动配置在启用 OTLP 导出时会构建 OtlpGrpcSpanExporter，
            该类必须在使用方运行时类路径上。exporter-otlp 会传递引入
            grpc / protobuf 等依赖，是本模块依赖树中较重的一部分；
            如果确认业务上只走 Java Agent 或 SkyWalking，不需要自建 OTLP 导出，
            应该删除本依赖而不是改回 optional（见下方"两种运行时路径"说明）。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!--
            OpenTelemetry SDK 自动配置扩展：optional。
            本模块的自动配置类直接使用 SDK 的 Builder API，不依赖本扩展；
            保留 optional 是为了让使用方在需要"通过环境变量 / 系统属性
            配置 OTel SDK"时可以自行引入，而不是被强行加入依赖树。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer 集成 Prometheus（optional） / Micrometer Prometheus registry (optional) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Admin 客户端（optional） / Spring Boot Admin client (optional) -->
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
