<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-redis</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>Redis 集成封装，提供分布式锁、缓存管理、对象存储等增强功能 / Redis integration: distributed locks, cache management, object storage and other enhancements</description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 通用基础库：项目通用工具和基础类 / Common library: shared utilities and base classes -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-common</artifactId>
        </dependency>

        <!-- Redis 客户端增强：支持分布式锁与数据结构 / Redis client enhancement: distributed locks and data structures -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Cache 自动化配置 / Spring Cache auto-configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Java 8 时间类型序列化支持 / Java 8 date-time serialization support -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

    </dependencies>

</project>
