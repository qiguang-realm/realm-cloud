<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-excel</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>Excel 拓展 / Excel extension</description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 通用基础库 / Common library -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-common</artifactId>
        </dependency>

        <!-- Spring Boot 核心 starter / Spring Boot core starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- RPC 组件（可选：用于远程调用） / RPC starter (optional: for remote procedure calls) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-rpc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web 支持（provided：仅在 ExcelUtils 中使用） / Web support (provided: used only by ExcelUtils) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Servlet API（provided：仅在 ExcelUtils 中使用） / Servlet API (provided: used only by ExcelUtils) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 工具类库：FastExcel / Utility libraries: FastExcel -->
        <dependency>
            <groupId>cn.idev.excel</groupId>
            <artifactId>fastexcel</artifactId>
        </dependency>

        <!-- 工具类库：Google Guava / Utility libraries: Google Guava -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- 业务组件（可选：仅在 AreaConvert 中使用） / Business component (optional: used only by AreaConvert) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-biz-ip</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试组件 / Test starter -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
