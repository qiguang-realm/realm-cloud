<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-excel</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>Excel 拓展 / Excel extension</description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 技术契约：realm-core / Technical contracts: realm-core -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-core</artifactId>
        </dependency>

        <!-- 通用工具类：realm-utils / General utilities: realm-utils -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-utils</artifactId>
        </dependency>

        <!-- Spring Boot 核心 starter / Spring Boot core starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- RPC 组件（可选：用于远程调用） / RPC starter (optional: for remote procedure calls) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-rpc</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Web 支持：optional，仅在 FastExcelUtil 的 Web 导出能力中使用。
            标记为 optional 而非 provided，原因：
              - provided 语义是“运行时由容器提供”，但 spring-web 由应用自身通过 spring-boot-starter-web 引入，并非容器自带；
              - optional 更准确地表达“导出功能需要时由调用方自备 spring-web”，
                非 Web 模块引用本 Starter 不会被动引入，也避免运行时 NoClassDefFoundError。
            Web support: optional, only used by FastExcelUtil's web export.
            Marked as optional rather than provided because spring-web is supplied by the
            application (via spring-boot-starter-web), not by the servlet container.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Servlet API：由 Servlet 容器（Tomcat/Jetty 等）在运行时提供，provided 语义正确。
            Servlet API: provided at runtime by the servlet container (Tomcat/Jetty, etc.).
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 工具类库：Apache Fesod (Incubating)（Excel 读写，FastExcel 的 Apache 演进版） -->
        <dependency>
            <groupId>org.apache.fesod</groupId>
            <artifactId>fesod-sheet</artifactId>
            <!-- 版本由父 BOM 统一管控，此处不指定 -->
        </dependency>

        <!-- 工具类库：Google Guava（集合、缓存、并发等工具） / Utility libraries: Google Guava (collections, cache, concurrency, etc.) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- 业务组件（可选：仅在 AreaConvert 中使用） / Business component (optional: used only by AreaConvert) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-biz-ip</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试组件 / Test starter -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
