<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-data-jpa</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>
        Spring Data JPA 集成支持：自动配置、实体扫描、Repository 扫描与事务管理。
        与 MyBatis-Plus 共存时，通过独立的事务管理器与包路径隔离避免冲突。

        Spring Data JPA integration: auto-configuration, entity scanning,
        repository scanning, and transaction management. When coexisting with
        MyBatis-Plus, conflicts are avoided via an isolated transaction manager
        and separate package scanning.
    </description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控，按功能分组） / Dependencies (all versions managed by parent; grouped by functional area) -->
    <dependencies>

        <!-- 基础工具类：提供 Realm 通用工具和基础 POJO / Foundation utilities: Realm common utilities and base POJOs -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-common</artifactId>
        </dependency>

        <!-- Web 与安全（provided：仅用于过滤器/拦截器，安全实现由使用方在运行时提供） / Web & security (provided: used only by filters/interceptors; security impl provided by consumers at runtime) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-security</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Data JPA 核心（含 Hibernate、Spring Data JPA、JDBC、HikariCP） / Spring Data JPA core (Hibernate, Spring Data JPA, JDBC, HikariCP) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 配置元数据生成器（生成 realm.jpa.* 配置项的 IDE 提示） / Configuration metadata processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 默认数据库驱动（默认包含 MySQL 驱动） / Default database driver (MySQL included by default) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 可选数据库驱动（标记为 optional，由使用方按需引入） / Optional database drivers (marked optional; consumers add the driver they need) -->
        <!-- Oracle 驱动 / Oracle driver -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- PostgreSQL 驱动 / PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- SQL Server 驱动 / SQL Server driver -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 达梦数据库驱动 / Dameng database driver -->
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 人大金仓驱动 / Kingbase database driver -->
        <dependency>
            <groupId>cn.com.kingbase</groupId>
            <artifactId>kingbase8</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 华为 openGauss 驱动 / Huawei openGauss driver -->
        <dependency>
            <groupId>org.opengauss</groupId>
            <artifactId>opengauss-jdbc</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>
