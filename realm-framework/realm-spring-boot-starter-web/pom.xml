<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-spring-boot-starter-web</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息：Web 框架能力（全局异常处理、API 日志、脱敏、错误码等） / Project info: web framework capabilities (global exception handling, API logging, desensitization, error codes, etc.) -->
    <name>${project.artifactId}</name>
    <description>
        Web 框架：全局异常处理、API 日志、脱敏、错误码等。
        Web framework: global exception handling, API logging, desensitization, error codes, etc.
    </description>
    <!-- 请替换为实际项目地址 / Replace with actual project URL -->
    <url>https://github.com/</url>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 通用基础库 / Common library -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-common</artifactId>
        </dependency>

        <!-- Spring Boot 配置元数据生成器（optional） / Spring Boot configuration metadata processor (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web 核心：Spring MVC 与参数校验 / Web core: Spring MVC & bean validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security 核心（provided：仅供 GlobalExceptionHandler 使用） / Spring Security core (provided: only for GlobalExceptionHandler) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenAPI 支持：Knife4j 与 SpringDoc / OpenAPI support: Knife4j & SpringDoc -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- RPC 组件（可选：用于远程调用） / RPC starter (optional: for remote procedure calls) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-rpc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 工具类库：Google Guava（provided：仅在工具类中使用） / Utility libraries: Google Guava (provided: used only in utility classes) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- XSS 防护：Jsoup / XSS protection: Jsoup -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- 测试相关：Spring Boot Test 与 Mockito Inline / Testing: Spring Boot Test & Mockito Inline -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
