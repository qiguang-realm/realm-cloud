<configuration>
    <!--
        ============================================================
        Logback 日志配置（含 MDC 链路追踪）
        参考 Spring Boot defaults.xml / file-appender.xml
        ============================================================
    -->

    <!-- ==== 日志格式 ==== -->
    <!--
        占位符：%d 日期 / %thread 线程 / %-5level 级别 / %logger{50} 记录器 / %L 行号 / %msg 消息 / %n 换行
        %X{tid}  MDC 中的 TID，缺省 N/A
        %tid     SkyWalking 链路追踪 ID
        CONSOLE 相比 FILE 多了 highlight、cyan 等高亮
    -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [TID:%X{tid:-N/A}] %highlight(%-5level) %cyan(%logger{50}:%L) - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [TID:%X{tid:-N/A}] %-5level %logger{50}:%L - %msg%n"/>
    <property name="SKYWALKING_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%tid] %-5level %logger{50}:%L - %msg%n"/>

    <!-- ==== Appender ==== -->

    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 文件输出（参考 Spring Boot file-appender.xml） -->
    <!-- 滚动策略：按天 + 大小；保留 30 天；单文件上限 10MB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- 保留天数 -->
            <maxFileSize>10MB</maxFileSize> <!-- 单文件大小上限 -->
        </rollingPolicy>
    </appender>

    <!-- 异步写入（基于 FILE，提升性能） -->
    <!-- queueSize 默认 256；discardingThreshold=0 表示不丢弃任何级别日志（默认队列 80% 满时丢 TRACE/DEBUG/INFO） -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- SkyWalking 日志上报（可选：需取消注释并添加依赖） -->
    <!-- 使用独立的 SKYWALKING_LOG_PATTERN，通过 %tid 输出 SkyWalking 链路 ID -->
    <!--
    <appender name="SKYWALKING" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>${SKYWALKING_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>
    -->

    <!-- ==== Root ==== -->
    <!-- 输出到控制台 + 异步文件 -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC"/> <!-- 本地不想输出文件日志时注释掉 -->
        <!-- <appender-ref ref="SKYWALKING"/> --> <!-- 接入 SkyWalking 日志中心时取消注释 -->
    </root>

</configuration>
