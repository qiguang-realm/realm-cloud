<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理；artifactId 必须是父 POM 的 artifactId，即 realm） / Parent POM (version ${revision} managed by parent; artifactId must be the parent's artifactId, i.e. realm) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId；packaging=pom 表示聚合模块） / Project coordinates (inherits groupId & version; packaging=pom indicates an aggregator module) -->
    <artifactId>realm-module-ai</artifactId>
    <packaging>pom</packaging>

    <!-- 项目信息 / Project information -->
    <name>${project.artifactId}</name>
    <description>
        ai 模块下，接入 LLM 大模型，支持聊天、绘图、音乐、写作、思维导图等功能。
        目前已接入各种模型，不限于：
        国内：通义千问、文心一言、讯飞星火、智谱 GLM、DeepSeek
        国外：OpenAI、Ollama、Midjourney、StableDiffusion、Suno

        The ai module integrates LLM large models, supporting chat, drawing, music,
        writing, mind maps, and more. Various models are currently supported, including:
        Domestic: Tongyi Qianwen, ERNIE Bot, iFlytek Spark, Zhipu GLM, DeepSeek
        International: OpenAI, Ollama, Midjourney, StableDiffusion, Suno
    </description>

    <!-- 子模块定义（按字母顺序排列，便于维护） / Module definitions (sorted alphabetically for maintainability) -->
    <modules>
        <!-- AI 模块 API 定义（供其他模块依赖） / API definitions for the ai module (for other modules to depend on) -->
        <module>realm-module-ai-api</module>
        <!-- AI 模块服务端实现（包含具体业务逻辑） / Server implementation of the ai module (contains business logic) -->
        <module>realm-module-ai-server</module>
    </modules>

</project>
