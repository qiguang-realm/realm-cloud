<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本（必需） / POM model version (required) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM 继承（版本 ${revision} 由父 POM 统一管理） / Parent POM (version ${revision} managed by parent) -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-module-ai</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- 项目标识（groupId 与 version 继承自父 POM，此处仅需指定 artifactId） / Project coordinates (inherits groupId & version) -->
    <artifactId>realm-module-ai-server</artifactId>
    <packaging>jar</packaging>

    <!-- 项目信息：AI 模块服务端实现，接入 LLM 大模型，支持聊天、绘图、音乐、写作、思维导图等功能 / Project info: server-side AI module integrating LLMs for chat, drawing, music, writing, mind maps, etc. -->
    <name>${project.artifactId}</name>
    <description>
        ai 模块下，接入 LLM 大模型，支持聊天、绘图、音乐、写作、思维导图等功能。
        目前已接入各种模型，不限于：
        国内：通义千问、文心一言、讯飞星火、智谱 GLM、DeepSeek
        国外：OpenAI、Ollama、Midjourney、StableDiffusion、Suno

        The ai module integrates LLM large models, supporting chat, drawing, music,
        writing, mind maps, and more. Various models are currently supported, including:
        Domestic: Tongyi Qianwen, ERNIE Bot, iFlytek Spark, Zhipu GLM, DeepSeek
        International: OpenAI, Ollama, Midjourney, StableDiffusion, Suno
    </description>

    <!-- 属性配置（仅本模块使用的版本） / Properties (versions used only by this module) -->
    <properties>
        <!-- Spring AI 版本 / Spring AI version -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- Spring AI Alibaba 版本（通义千问）：https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba / Spring AI Alibaba version (Tongyi Qianwen) -->
        <alibaba-ai.version>1.1.2.2</alibaba-ai.version>
        <!-- TinyFlow AI 工作流版本 / TinyFlow AI workflow version -->
        <tinyflow.version>1.2.6</tinyflow.version>
    </properties>

    <!-- 依赖管理（仅本模块内的 BOM，不向下传递） / Dependency management (module-local BOM, not propagated) -->
    <dependencyManagement>
        <dependencies>
            <!-- 导入 Spring AI BOM，统一管理 spring-ai-* 依赖版本 / Import Spring AI BOM to manage spring-ai-* versions -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 依赖配置（所有版本由父 POM 的 dependencyManagement 统一管控） / Dependencies (all versions managed by parent) -->
    <dependencies>

        <!-- 框架基础：环境拓展（特性环境能力） / Framework foundation: env extension (feature environment capability) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-env</artifactId>
        </dependency>

        <!-- 内部模块 API：system / infra / ai 模块接口定义 / Internal module APIs: system, infra, and ai interface definitions -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-ai-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件：多租户支持 / Business component: multi-tenancy support -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 与安全：安全框架 / Web & security: security framework -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 数据库与持久化：MyBatis 与 Redis / Database & persistence: MyBatis and Redis -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 微服务与 RPC：Feign 客户端与 Nacos 注册/配置中心 / Microservices & RPC: Feign client and Nacos registry/config center -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-rpc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- 定时任务 / Job scheduling -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- 工具类：Excel 拓展 / Utility: Excel extension -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- 监控组件 / Monitoring starter -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-monitor</artifactId>
        </dependency>

        <!-- Spring AI 模型接入：OpenAI（排除 swagger 注解避免与项目 swagger 冲突） / Spring AI models: OpenAI (exclude swagger annotations to avoid conflict) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations-jakarta</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Azure OpenAI -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-azure-openai</artifactId>
        </dependency>
        <!-- Anthropic Claude -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <!-- DeepSeek -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <!-- Ollama（本地模型） / Ollama (local models) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- Stability AI（绘图） / Stability AI (drawing) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-stability-ai</artifactId>
        </dependency>
        <!-- 通义千问（阿里云 DashScope） / Tongyi Qianwen (Alibaba Cloud DashScope) -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>${alibaba-ai.version}</version>
        </dependency>

        <!-- 向量存储（参考：https://db-engines.com/en/ranking/vector+dbms） / Vector stores (ref: https://db-engines.com/en/ranking/vector+dbms) -->
        <!-- Qdrant：https://qdrant.tech/ -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
        </dependency>
        <!-- Redis：https://redis.io/docs/latest/develop/get-started/vector-database/ -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>
        <!-- Milvus：https://milvus.io/（排除 slf4j-reload4j 解决与 logback 的日志冲突） / Milvus (exclude slf4j-reload4j to avoid logback conflict) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 文档解析：Tika（排除 spring-cloud-function，避免与 boot 项目冲突） / Document parsing: Tika (exclude spring-cloud-function to avoid conflicts with boot project) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-function-context</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-function-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MCP 相关：必须使用 webmvc 版本（项目使用 Spring MVC，非 WebFlux；使用 webflux 版本会导致 SSE Server 失效） / MCP: webmvc variant required (project uses Spring MVC; webflux variant would break SSE Server) -->
        <!-- MCP 服务端（排除 swagger 注解避免冲突） / MCP server (exclude swagger annotations to avoid conflict) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations-jakarta</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- MCP 客户端 / MCP client -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- TinyFlow：AI 工作流（排除冲突依赖：enjoy、agents-flex ES 相关、groovy、日志实现、fastjson 等） / TinyFlow: AI workflow (exclude conflicting deps) -->
        <dependency>
            <groupId>dev.tinyflow</groupId>
            <artifactId>tinyflow-java-core</artifactId>
            <version>${tinyflow.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.jfinal</groupId>
                    <artifactId>enjoy</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.agentsflex</groupId>
                    <artifactId>agents-flex-store-elasticsearch</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.agentsflex</groupId>
                    <artifactId>agents-flex-search-engine-es</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.codehaus.groovy</groupId>
                    <artifactId>groovy-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.alibaba</groupId>
                    <artifactId>fastjson</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 测试组件（test 作用域） / Test starter (test scope) -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- 构建配置 / Build configuration -->
    <build>
        <!-- 设置构建的 JAR 包名 / Set the final JAR name -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Spring Boot 打包插件（将应用打包为包含全部依赖的可执行 JAR） / Spring Boot Maven Plugin (repackage as executable JAR) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <!-- 将依赖一同打入最终包 / Repackage with all dependencies -->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
